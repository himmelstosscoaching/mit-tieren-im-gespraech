---
import { kursTon, type Kurs } from '../data/kurse';
interface Props { kurs: Kurs }
const { kurs } = Astro.props;
---
<article class="card course" style={`--kurs: var(--kurs-${kurs.slug}); background: ${kursTon(kurs.stufe)}`}>
  <span class="course__tag">Stufe {kurs.stufe}</span>
  <h3>{kurs.titel}</h3>
  <p class="muted course__sub">{kurs.untertitel}</p>
  <p>{kurs.kurz}</p>
  <p class="course__meta muted">{kurs.dauer}</p>
  <p class="price">{kurs.preis} € <small>pro Person</small></p>
  {kurs.slug !== 'profikurs' && <a class="course__youth" href="/kurse#jugendliche">Auch als Jugendkurs</a>}
  <a class="btn course__btn" href={`/kurse/${kurs.slug}`}>Zum {kurs.titel}</a>
</article>

<style>
  .course { border-top: 6px solid var(--kurs); }
  .course__tag { align-self: flex-start; background: var(--kurs); color: var(--white); font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase; padding: 0.3rem 0.85rem; border-radius: 999px; margin-bottom: 0.2rem; }
  .course__sub { margin-top: -0.4rem; font-style: italic; }
  .course__meta { font-size: 0.92rem; }
  .course .price { color: var(--kurs); }
  .course__youth { font-size: 0.92rem; font-weight: 700; color: var(--turq); margin-top: -0.4rem; }
  .course__btn { background: transparent; color: var(--kurs); border-color: var(--kurs); }
  .course__btn:hover { background: var(--kurs); color: var(--white); }
</style>
