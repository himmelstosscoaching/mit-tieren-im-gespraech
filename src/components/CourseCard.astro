---
import type { Kurs } from '../data/kurse';
interface Props { kurs: Kurs }
const { kurs } = Astro.props;
---
<article class="card course">
  <span class="eyebrow">Stufe {kurs.stufe}</span>
  <h3>{kurs.titel}</h3>
  <p class="muted course__sub">{kurs.untertitel}</p>
  <p>{kurs.kurz}</p>
  <p class="course__meta muted">{kurs.dauer}</p>
  <p class="price">{kurs.preis} € <small>pro Person</small></p>
  <a class="btn btn--ghost" href={`/kurse/${kurs.slug}`}>Zum {kurs.titel}</a>
</article>

<style>
  .course__sub { margin-top: -0.4rem; font-style: italic; }
  .course__meta { font-size: 0.92rem; }
  .course .eyebrow { margin-bottom: 0.2rem; }
</style>
