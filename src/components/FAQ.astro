---
interface Item { q: string; a: string }
interface Props { items: Item[] }
const { items } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
<div class="faq">
  {items.map((i) => (
    <details class="faq__item">
      <summary>{i.q}</summary>
      <p>{i.a}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .faq { display: grid; gap: 0.75rem; }
  .faq__item { background: var(--white); border-radius: var(--radius); padding: 0 1.4rem; box-shadow: var(--shadow); }
  .faq__item summary { cursor: pointer; padding: 1.1rem 2.2rem 1.1rem 0; font-family: var(--font-display); font-size: 1.15rem; font-weight: 500; list-style: none; position: relative; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 1.6rem; color: var(--clay); font-family: var(--font-body); font-weight: 300; transition: transform 0.2s ease; }
  .faq__item[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .faq__item p { padding-bottom: 1.2rem; color: var(--ink-soft); }
</style>
