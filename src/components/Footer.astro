---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <p class="footer__brand">{site.name}</p>
      <p class="muted">{site.owner}<br />{site.street}<br />{site.zip} {site.city}</p>
    </div>
    <div>
      <p class="footer__head">Angebot</p>
      <ul>
        <li><a href="/tiergespraech">Tiergespräch</a></li>
        <li><a href="/kurse/basiskurs">Basiskurs</a></li>
        <li><a href="/kurse/aufbaukurs">Aufbaukurs</a></li>
        <li><a href="/kurse/profikurs">Profikurs</a></li>
        <li><a href="/tiergespraech#abschied">Abschied</a></li>
        <li><a href="/kurse#jugendliche">Für Jugendliche</a></li>
        <li><a href="/kurse#extras">Lernabende</a></li>
        <li><a href="/krafttiere">Krafttiere</a></li>
        <li><a href="/reiten">Reitunterricht &amp; Beritt</a></li>
      </ul>
    </div>
    <div>
      <p class="footer__head">Kontakt</p>
      <ul>
        <li><a href="/kontakt">Anfrage senden</a></li>
        <li><a href={site.instagram} rel="noopener" target="_blank">Instagram {site.instagramHandle}</a></li>
        <li><a href="/ueber-mich">Über mich</a></li>
      </ul>
    </div>
    <div>
      <p class="footer__head">Rechtliches</p>
      <ul>
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutz</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer__bottom">
    <p class="muted">© {year} {site.owner} · Tierkommunikation in {site.city}</p>
  </div>
</footer>

<style>
  .footer { background: var(--cream-deep); border-top: 6px solid transparent; border-image: var(--gradient) 1; padding-block: 3.5rem 2rem; margin-top: 2rem; font-size: 0.95rem; }
  .footer__grid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .footer__brand { font-family: var(--font-display); font-size: 1.35rem; margin-bottom: 0.5rem; }
  .footer__head { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700; color: var(--ink-soft); margin-bottom: 0.6rem; }
  .footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.4rem; }
  .footer a { text-decoration: none; }
  .footer a:hover { text-decoration: underline; }
  .footer__bottom { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--sand); font-size: 0.85rem; }
</style>
