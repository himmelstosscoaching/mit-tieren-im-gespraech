---
/**
 * Hero-Slider: große Fotos laufen als sanfte Überblendung durch,
 * darüber ein fester Header-Text. Bilder in `slides` austauschen.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Slide { src: ImageMetadata; alt: string; position?: string }
interface Props {
  slides: Slide[];
  eyebrow?: string;
  title: string;
  text: string;
}
const { slides, eyebrow, title, text } = Astro.props;
---
<section class="hero" data-hero aria-label="Willkommen">
  <div class="hero__slides">
    {slides.map((s, i) => (
      <div class:list={['hero__slide', { 'is-active': i === 0 }]} style={`--pos:${s.position ?? 'center'}`} data-slide>
        <Picture
          src={s.src}
          alt={s.alt}
          widths={[640, 1024, 1600, 2200]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          decoding="async"
        />
      </div>
    ))}
    <div class="hero__shade"></div>
  </div>

  <div class="wrap hero__content">
    {eyebrow && <span class="hero__eyebrow">{eyebrow}</span>}
    <h1 class="hero__title">{title}</h1>
    <p class="hero__text">{text}</p>
    <div class="btn-row">
      <a class="btn btn--light" href="/tiergespraech">Tiergespräch anfragen</a>
      <a class="btn btn--outline-light" href="/kurse">Kurse entdecken</a>
    </div>
  </div>

  {slides.length > 1 && (
    <div class="hero__dots" role="tablist" aria-label="Bilder">
      {slides.map((s, i) => (
        <button type="button" class:list={['hero__dot', { 'is-active': i === 0 }]} data-dot={i} aria-label={`Bild ${i + 1}`}></button>
      ))}
    </div>
  )}
</section>

<style>
  .hero { position: relative; min-height: min(92svh, 900px); display: grid; align-items: end; color: var(--cream); isolation: isolate; overflow: hidden; background: var(--moss-deep); }
  .hero__slides { position: absolute; inset: 0; z-index: -1; }
  .hero__slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.6s ease; }
  .hero__slide.is-active { opacity: 1; }
  .hero__slide :global(picture) { position: absolute; inset: 0; display: block; }
  .hero__slide :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); transform: scale(1.02); }
  .hero__slide.is-active :global(img) { animation: kenburns 9s ease-out forwards; }
  @keyframes kenburns { from { transform: scale(1.02); } to { transform: scale(1.09); } }
  .hero__shade { position: absolute; inset: 0; background:
    linear-gradient(to top, rgba(26, 30, 22, 0.86) 0%, rgba(26, 30, 22, 0.45) 38%, rgba(26, 30, 22, 0.12) 65%, rgba(26, 30, 22, 0.3) 100%); }
  .hero__content { padding-block: clamp(6rem, 14vh, 9rem) clamp(4.5rem, 10vh, 7rem); max-width: 760px; margin-left: max(var(--gutter), calc((100% - var(--max)) / 2)); }
  .hero__eyebrow { display: inline-block; font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; color: var(--gold); margin-bottom: 1rem; }
  .hero__title { font-size: var(--fs-hero); color: var(--cream); margin-bottom: 0.4em; text-shadow: 0 2px 30px rgba(0,0,0,0.25); }
  .hero__text { font-size: var(--fs-lead); max-width: 560px; color: rgba(250, 246, 239, 0.92); margin-bottom: 1.75rem; text-wrap: pretty; }
  .hero__dots { position: absolute; right: var(--gutter); bottom: 1.5rem; display: flex; gap: 0.5rem; }
  .hero__dot { width: 10px; height: 10px; border-radius: 50%; border: 0; background: rgba(250, 246, 239, 0.45); cursor: pointer; padding: 0; transition: transform 0.2s ease, background 0.2s ease; }
  .hero__dot.is-active { background: var(--cream); transform: scale(1.3); }
  @media (max-width: 600px) { .hero__dots { left: var(--gutter); right: auto; bottom: 1.1rem; } .hero__content { padding-bottom: 4rem; } }
</style>

<script>
  const hero = document.querySelector('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll('[data-slide]')];
    const dots = [...hero.querySelectorAll('[data-dot]')];
    let i = 0;
    let timer: number | undefined;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === i));
      dots.forEach((d, k) => d.classList.toggle('is-active', k === i));
    };
    const start = () => { if (!reduce && slides.length > 1) timer = window.setInterval(() => show(i + 1), 6500); };
    const stop = () => { if (timer) window.clearInterval(timer); };
    dots.forEach((d, k) => d.addEventListener('click', () => { stop(); show(k); start(); }));
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  }
</script>
