---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  transparentHeader?: boolean;
  mobileCta?: { href: string; label: string } | false;
}
const { title, description, transparentHeader = false, mobileCta = { href: '/kontakt', label: 'Tiergespräch anfragen' } } = Astro.props;
const fullTitle = title === site.name ? `${site.name} – ${site.claim}` : `${title} · ${site.name}`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <link rel="canonical" href={new URL(Astro.url.pathname, site.url)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- TODO vor Livegang: Schriften selbst hosten (INHALT-08) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Nunito+Sans:ital,opsz,wght@0,6..12,400;0,6..12,600;0,6..12,700;1,6..12,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt springen</a>
    <Header transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {mobileCta && <MobileCta href={mobileCta.href} label={mobileCta.label} />}
    <script>
      // Sanftes Einblenden beim Scrollen (respektiert „Bewegung reduzieren")
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('.section > .wrap > *, .section > .wrap--narrow > *, .card, .steps__item, .faq__item');
      if (!reduce && 'IntersectionObserver' in window) {
        // Nur, was beim Laden unterhalb des Bildschirms liegt, wird animiert – der erste Blick bleibt sofort sichtbar.
        els.forEach((el) => { if (el.getBoundingClientRect().top > window.innerHeight) el.classList.add('reveal'); });
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      }
      // Karussell-Punkte
      document.querySelectorAll('[data-scroller]').forEach((sc) => {
        const dots = sc.nextElementSibling?.querySelectorAll('span');
        if (!dots) return;
        sc.addEventListener('scroll', () => {
          const kids = [...sc.children];
          const mid = sc.scrollLeft + sc.clientWidth / 2;
          let idx = 0;
          kids.forEach((k, i) => { const el = k as HTMLElement; if (el.offsetLeft <= mid) idx = i; });
          dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
        }, { passive: true });
      });
    </script>
  </body>
</html>
