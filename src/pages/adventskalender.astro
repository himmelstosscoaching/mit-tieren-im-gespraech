---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import imgSee from '../assets/img/see-abendrot-mit-hund.jpg';

// Angaben zum Kalender – hier ändern, wirkt überall auf dieser Seite.
const advent = {
  start: 'Dienstag, 1. Dezember',
  preis: '50 €',
  zugang: 'In unserer WhatsApp-Gruppe oder, wenn du magst, per E-Mail',
  anmeldeschluss: '1. Dezember, 24 Uhr',
};
---
<Base
  title="Adventskalender"
  ogImage="/og/adventskalender.jpg"
  description="Bewusst mit den Tieren durch den Advent: 24 Tage Stille, Natur und Botschaften der Tiere – mit kleinen Übungen und einer persönlichen Tierbotschaft am 24. Dezember."
  mobileCta={{ href: '#anmeldung', label: 'Zum Adventskalender anmelden' }}
>
  <!-- 1 · Einstieg -->
  <section class="section section--zeichnung">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Adventskalender 2026</span>
        <h1>Bewusst mit den Tieren durch den Advent</h1>
        <p class="lead">24 Tage Stille, Natur und Botschaften der Tiere.</p>
        <p>Die Adventszeit ist oft laut. Vorbereiten, besorgen, fertig werden, alles im Außen. Der Adventskalender von Mit Tieren im Gespräch lädt dich ein, jeden Tag einen kurzen Moment nach innen zu gehen. Zu dir, zur Natur und zu den Tieren.</p>
        <p class="advent-start">Start: {advent.start}</p>
        <div class="btn-row" style="margin-top:1.5rem">
          <a class="btn btn--primary" href="#anmeldung">Jetzt anmelden</a>
          <a class="btn btn--ghost" href="#inhalt">Was dich erwartet</a>
        </div>
      </div>
      <figure class="photo photo--portrait advent-foto" style="margin:0">
        <Image src={imgSee} alt="Ein Border Collie mit rotem Ball am Ufer eines stillen Sees, Bäume und Himmel spiegeln sich im Morgenrot" widths={[480, 800, 1200]} sizes="(min-width: 860px) 520px, 100vw" loading="eager" />
      </figure>
    </div>
  </section>

  <!-- 2 · Was dich erwartet -->
  <section class="section section--sand" id="inhalt">
    <div class="wrap">
      <div class="center" style="max-width:720px;margin-inline:auto;margin-bottom:2.5rem">
        <span class="eyebrow">Was dich erwartet</span>
        <h2>Jeden Tag ein Türchen nach innen</h2>
      </div>
      <div class="grid grid--3">
        <article class="offer" style="--farbe: var(--turq)">
          <span class="offer__icon" aria-hidden="true">✦</span>
          <h3>Botschaften der Tiere</h3>
          <p>Sie entstehen eigens für diesen Kalender. Es sind Impulse, die die Tiere in unsere Runde geben, für genau die Menschen, die dabei sind.</p>
        </article>
        <article class="offer" style="--farbe: var(--blue)">
          <span class="offer__icon" aria-hidden="true">❋</span>
          <h3>Kleine Übungen</h3>
          <p>Geführte Meditationen und Wahrnehmungsübungen. Sie öffnen einen stillen Raum, in dem du Tiere feiner wahrnehmen kannst, und geben dir einen ersten Zugang zur Energiearbeit.</p>
        </article>
        <article class="offer" style="--farbe: var(--clay-deep); --farbe-text: var(--gold-text)">
          <span class="offer__icon" aria-hidden="true">★</span>
          <h3>Am 24. Dezember: dein Geschenk</h3>
          <p>Eine persönliche Tierbotschaft. Von deinem eigenen Tier oder, wenn du keines hast, von einem Wunschtier.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 3 · Die 24 Türchen -->
  <section class="section">
    <div class="wrap--narrow center">
      <span class="logo-zeichnung" aria-hidden="true"></span>
      <span class="eyebrow">Tag für Tag</span>
      <h2>Ein stiller Innenraum, mitten in der Weihnachtszeit</h2>
      <ol class="tuerchen" aria-label="24 Tage vom 1. bis 24. Dezember">
        {Array.from({ length: 24 }, (_, i) => (
          <li class:list={{ 'tuerchen--geschenk': i === 23 }}>{i === 23 ? <><span>24</span><small>für dich</small></> : i + 1}</li>
        ))}
      </ol>
      <p class="lead">So entsteht Tag für Tag ein stiller Innenraum. Momente, aus denen du Kraft schöpfen kannst, mitten in der Weihnachtszeit. Und vieles davon kannst du auch nach Weihnachten weiter nutzen.</p>
    </div>
  </section>

  <!-- 4 · Anmeldung -->
  <section class="section section--sand" id="anmeldung">
    <div class="wrap split" style="align-items:start">
      <div>
        <span class="eyebrow">Anmeldung</span>
        <h2>Sei dabei</h2>
        <p class="lead">Melde dich an, und ab dem 1. Dezember öffnet sich jeden Tag ein Türchen für dich.</p>
        <dl class="facts" style="margin-top:1.75rem">
          <div><dt>Zeitraum</dt><dd>1. bis 24. Dezember, jeden Tag ein Türchen</dd></div>
          <div><dt>So kommt es zu dir</dt><dd>{advent.zugang}</dd></div>
          <div><dt>Begleitet von</dt><dd>Steffi, Mit Tieren im Gespräch</dd></div>
          <div><dt>Anmeldung bis</dt><dd>{advent.anmeldeschluss}</dd></div>
          <div><dt>Preis</dt><dd class="price">{advent.preis}</dd></div>
        </dl>
      </div>

      <!-- Digistore24-Bestellformular: Produkt 773778, Formular 256812 (Konto Himmelstosscoaching) -->
      <div class="bestellung">
        <script is:inline src="https://www.checkout-ds24.com/service/digistore.js"></script>
        <my-order-form product-id="773778" width="100%" base-url="https://www.checkout-ds24.com" order-form-id="256812"></my-order-form>
        <noscript><a class="btn btn--primary" href="https://www.checkout-ds24.com/product/773778">Zur Bestellung</a></noscript>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Nur auf dieser Seite: warmer, zart cremig-oranger Grundton statt Kühlblau-Weiß */
  :global(body) { --cream: #fdf6ec; --cream-deep: #fbecd8; --sand: #f1dcc0; background: var(--cream); }
  :global(.header), :global(.header--transparent.is-scrolled) { background: rgba(253, 246, 236, 0.94) !important; }

  .advent-start { display: inline-block; margin-top: 0.5rem; padding: 0.35rem 0.95rem; border-radius: 999px;
    background: var(--gold-soft); color: var(--navy); font-weight: 700; }

  .offer__icon { font-size: 1.6rem; line-height: 1; color: var(--farbe-text, var(--farbe)); }

  /* 24 Türchen: ruhiges Raster, das 24. leuchtet golden */
  .tuerchen { list-style: none; padding: 0; margin: 2rem auto 2.25rem; display: grid; grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem; max-width: 520px; counter-reset: none; }
  .tuerchen li { aspect-ratio: 1; display: grid; place-items: center; border-radius: 12px; border: 1.5px solid var(--sand);
    background: var(--white); font-family: var(--font-display); font-size: clamp(1rem, 3.6vw, 1.3rem); color: var(--blue); }
  .tuerchen li:nth-child(3n+2) { background: var(--cream-deep); }
  .tuerchen--geschenk { background: var(--rose) !important; border-color: var(--rose) !important; color: var(--navy) !important;
    align-content: center; gap: 0; line-height: 1.05; box-shadow: 0 10px 24px -12px rgba(222, 151, 49, 0.7); }
  .tuerchen--geschenk small { font-family: var(--font-body); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  @media (min-width: 860px) { .tuerchen { grid-template-columns: repeat(8, 1fr); max-width: 640px; } }

  .advent-foto :global(img) { object-position: center 100%; }

  /* Handy: Foto im Einstieg flacher, damit Text und Anmeldung schneller kommen */
  @media (max-width: 859px) {
    .advent-foto :global(img) { aspect-ratio: 1 / 1; object-position: center 100%; }
    .advent-start { font-size: 0.95rem; }
    .btn-row .btn { flex: 1 1 100%; }
  }

  .bestellung { background: #fff; border-radius: 18px; overflow: hidden; }
  @media (max-width: 859px) { .bestellung { margin-inline: -0.6rem; } }
</style>
