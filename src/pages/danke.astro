---
import Base from '../layouts/Base.astro';
---
<Base title="Danke" description="Deine Nachricht ist angekommen.">
  <section class="section">
    <div class="wrap--narrow center">
      <span class="eyebrow">Angekommen</span>
      <h1>Danke für deine Nachricht.</h1>
      <p class="lead">Ich melde mich so bald wie möglich persönlich bei dir. Bis dahin: Grüß dein Tier von mir.</p>
      <a class="btn btn--ghost" href="/" style="margin-top:1.5rem">Zurück zur Startseite</a>
    </div>
  </section>
</Base>
