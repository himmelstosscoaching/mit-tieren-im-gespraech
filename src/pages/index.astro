---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import QuoteBanner from '../components/QuoteBanner.astro';
import Steps from '../components/Steps.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import CourseCard from '../components/CourseCard.astro';
import { Image } from 'astro:assets';
import { kurse } from '../data/kurse';
import { site } from '../data/site';

import imgGalloway from '../assets/img/steffi-hund-galloway-schnee.jpg';
import imgPferd from '../assets/img/steffi-pferd-schnee.jpg';
import imgStuhl from '../assets/img/steffi-haengestuhl-pferde.jpg';
import imgSee from '../assets/img/hunde-am-see-sonnenaufgang.jpg';
import imgGalopp from '../assets/img/pferd-galopp-apfelbaum.jpg';
import imgPferdekopf from '../assets/img/pferdekopf-nahaufnahme.jpg';
import imgFendt from '../assets/img/vier-hunde-auf-fendt-scheune.jpg';
import imgDreiPferde from '../assets/img/drei-pferde-galopp-wiese.jpg';
import imgAbendrot from '../assets/img/see-abendrot-hund-silhouette.jpg';
import imgAnna from '../assets/img/anna-rex-begegnung.jpg';

const slides = [
  { src: imgStuhl, alt: 'Steffi sitzt im Hängestuhl auf der Wiese, ein Pferd kommt zu ihr, ihr Hund steht daneben – Abendlicht', position: 'center 60%' },
  { src: imgGalloway, alt: 'Steffi kniet im Schnee, im Arm ihr Border Collie, daneben ein schwarzes Galloway-Rind', position: 'center 35%' },
  { src: imgSee, alt: 'Zwei Border Collies stehen auf Steinen im See, dahinter geht die Sonne auf', position: 'center 60%' },
  { src: imgGalopp, alt: 'Ein Pferd galoppiert unter einem Apfelbaum, der Himmel leuchtet rosa', position: 'center 50%' },
];

const steps = [
  { title: 'Du schreibst mir', text: 'Ein Foto deines Tieres, sein Name und das, was dich gerade beschäftigt – mehr brauche ich nicht.' },
  { title: 'Ich verbinde mich', text: 'Ich nehme innerlich Kontakt zu deinem Tier auf. Wo es gerade ist, spielt keine Rolle.' },
  { title: 'Wir sprechen am Telefon', text: 'Gemeinsam gehen wir deine Fragen durch – etwa eine Stunde lang, in Ruhe und ohne Zeitdruck.' },
  { title: 'Du nimmst etwas mit', text: 'Ein klareres Bild davon, wie es deinem Tier geht, was es braucht – und was ihr als Nächstes tun könnt. Das ganze Gespräch bekommst du danach auch schriftlich.' },
];

const faq = [
  { q: 'Muss mein Tier beim Gespräch dabei sein?', a: 'Nein. Die Kommunikation muss nicht vor Ort stattfinden – sie erfolgt auf einer anderen Ebene, deshalb ist sie mit Tieren auf der ganzen Welt möglich. Ich verbinde mich innerlich mit deinem Tier; dafür brauche ich nur ein Foto und seinen Namen.' },
  { q: 'Wie sprechen Tiere überhaupt mit uns?', a: 'Die meisten Tiere kommunizieren über Bilder, Gefühle und Worte. Dabei gibt es – genau wie bei uns Menschen – Unterschiede: Manchen fällt es leichter, Bilder zu senden oder wahrzunehmen, andere verständigen sich eher über Worte oder Gefühle. In den Kursen lernst du die verschiedenen Möglichkeiten kennen, und wir schauen, wie es für dich am besten funktioniert.' },
  { q: 'Wie weiß ich, dass du wirklich mit meinem Tier sprichst?', a: 'Ich frage die Tiere gern, ob sie mir etwas sagen, das ich nicht wissen kann. Das gibt auch mir Sicherheit – und du hörst selbst, ob du dein Tier wiedererkennst.' },
  { q: 'Wann ist ein Tiergespräch sinnvoll?', a: 'Wenn sich im Alltag etwas verändert – ein Umzug, ein neues Familienmitglied – oder wenn es ein Problem gibt, für das ihr bisher keine Lösung gefunden habt, etwa eine Erkrankung oder unerwünschtes Verhalten. Und auch dann, wenn du dein Tier einfach besser kennenlernen und mehr über seine Bedürfnisse und sein Erleben erfahren möchtest.' },
  { q: 'Kann ich Tierkommunikation selbst lernen?', a: 'Ja. Die Fähigkeit zur Telepathie trägt jeder Mensch in sich. Sie ist wie ein Muskel, den wir wieder trainieren können, um in der Kommunikation sicherer und klarer zu werden. Genau das machen wir im Basiskurs – ganz praktisch, mit vielen Übungen und echten Gesprächen.' },
  { q: 'Für wen sind die Kurse geeignet?', a: 'Für alle, die ihre Tiere noch besser verstehen möchten – und für Menschen, die Tierkommunikation später in ihre berufliche Tätigkeit integrieren oder selbstständig Tiergespräche anbieten wollen. Vorkenntnisse brauchst du für den Basiskurs nicht.' },
  { q: 'Wo finden die Kurse statt?', a: `Bei mir zu Hause auf dem Hof in ${site.city}, ${site.street} – ${site.region}. Meine Tiere sind mit dabei.` },
];
---
<Base title={site.name} description="Tiergespräche am Telefon und Kurse, in denen du Tierkommunikation selbst lernst – bei Steffi Himmelstoß auf einem kleinen Hof in Emmingen-Liptingen bei Tuttlingen, zwischen Bodensee und Schwarzwald." transparentHeader>
  <HeroSlider
    slides={slides}
    eyebrow="Tierkommunikation · Emmingen-Liptingen"
    title="Dein Tier hat dir etwas zu sagen."
    text="Ich bin Steffi, Tierkommunikatorin auf einem kleinen Hof bei Tuttlingen. In Tiergesprächen höre ich deinem Tier zu – und in meinen Kursen lernst du, es selbst zu tun."
  />

  <section class="section">
    <div class="wrap--narrow center">
      <span class="eyebrow">Was ist Tierkommunikation?</span>
      <h2>Ein Gespräch auf einer anderen Ebene.</h2>
      <p class="lead">Tierkommunikation ist telepathische Kommunikation mit einem Tier. Tiere sprechen in Bildern, Gefühlen und Worten – jedes auf seine eigene Weise, genau wie wir Menschen. Diese Fähigkeit steckt in jedem von uns. Sie ist wie ein Muskel: Man muss ihn nur wieder trainieren.</p>
    </div>
  </section>

  <section class="section section--sand section--tight">
    <div class="wrap">
      <div class="center" style="max-width:720px;margin-inline:auto;margin-bottom:2.5rem">
        <span class="eyebrow">Meine Angebote</span>
        <h2>Wie ich dich und dein Tier begleite</h2>
      </div>
      <div class="grid grid--2">
        <article class="card card--img card--farbe" style="--farbe: var(--turq)">
          <Image src={imgPferdekopf} alt="Nahaufnahme eines Schimmels, der über die Felder schaut" widths={[480, 800, 1200]} sizes="(min-width: 860px) 560px, 100vw" loading="lazy" />
          <div class="card__body">
            <h3>Tiergespräch</h3>
            <p>Wenn dein Tier krank ist, sich anders verhält, eine Veränderung ansteht – oder du einfach wissen willst, wie es ihm wirklich geht. Wir sprechen gemeinsam mit deinem Tier, am Telefon, etwa eine Stunde lang.</p>
            <p>Auch im Abschied: Ich begleite dich und dein Tier auf seinem letzten Weg – und auch danach. <a href="/tiergespraech#abschied">Mehr zum Abschied</a></p>
            <a class="btn btn--primary" href="/tiergespraech">Mehr zum Tiergespräch</a>
          </div>
        </article>
        <article class="card card--img card--farbe" style="--farbe: var(--blue)">
          <Image src={imgFendt} alt="Vier Border Collies sitzen auf dem alten Fendt in der Scheune" widths={[480, 800, 1200]} sizes="(min-width: 860px) 560px, 100vw" loading="lazy" />
          <div class="card__body">
            <h3>Ausbildung in Tierkommunikation</h3>
            <p>In drei Stufen vom ersten Wochenende bis zum eigenen Beruf: Im Basis-, Aufbau- und Profikurs lernst du in kleiner Runde, bewusst und klar mit Tieren zu sprechen – mit deinen und mit fremden.</p>
            <p><a href="/kurse#jugendliche"><strong>Basis- und Aufbaukurs gibt es auch als Jugendkurs (14 bis 18 Jahre).</strong></a></p>
            <a class="btn btn--primary" href="/kurse">Zur Ausbildung</a>
          </div>
        </article>
      </div>
      <div class="grid grid--2" style="margin-top:clamp(1.25rem, 3vw, 2.5rem)">
        <article class="offer" style="--farbe: var(--violet)">
          <h3>Krafttiere</h3>
          <p>Krafttierarbeit und Krafttierreisen: Lerne dein Krafttier kennen – und die Kraft, die es dir für deinen Alltag schenkt.</p>
          <a class="btn btn--ghost" href="/krafttiere">Mehr zu den Krafttieren</a>
        </article>
        <article class="offer" style="--farbe: var(--turq)">
          <h3>Reitunterricht &amp; Beritt</h3>
          <p>Als Reitlehrerin und Trainerin gebe ich weiter, was mir die Pferde beigebracht haben.</p>
          <a class="btn btn--ghost" href="/reiten">Mehr zum Reiten</a>
        </article>
      </div>
    </div>
  </section>

  <QuoteBanner
    image={imgDreiPferde}
    alt="Vier Pferde galoppieren über die Wiese, darüber ein weiter blauer Himmel"
    quote="Tierkommunikation ist wie ein Muskel, den man in alle Richtungen trainieren kann."
    author="Steffi"
    position="30% 72%"
    align="top"
  />

  <section class="section">
    <div class="wrap">
      <div class="center" style="max-width:720px;margin-inline:auto;margin-bottom:2.5rem">
        <span class="eyebrow">Ablauf</span>
        <h2>So läuft ein Tiergespräch ab</h2>
      </div>
      <Steps steps={steps} />
      <figure class="stimme">
        <Image src={imgAnna} alt="Anna beugt sich zu ihrem Hund Rex hinunter und begrüßt ihn auf der Wiese" widths={[400, 800]} sizes="(min-width: 760px) 320px, 100vw" loading="lazy" />
        <blockquote class="testimonial">
          <p>„Dass ein Tier mir mein eigenes Thema spiegeln kann, hätte ich nie gedacht.“</p>
          <p class="stimme__text">Steffi hat aus der Ferne mit meinem geretteten Kettenhund Rex gesprochen. Was sie durchgab, war der Schlüssel zu ihm – und zu mir. Kurz darauf kam er zum ersten Mal freiwillig durchs Tor zurück.</p>
          <footer style="color: #d42a4c">Anna mit Rex · <a href="/tiergespraech#anna">Ganze Geschichte lesen</a></footer>
        </blockquote>
      </figure>
      <div class="center" style="margin-top:2.5rem">
        <a class="btn btn--primary" href="/kontakt">Tiergespräch anfragen</a>
      </div>
    </div>
  </section>

  <section class="section section--sand">
    <div class="wrap">
      <div class="center" style="max-width:720px;margin-inline:auto;margin-bottom:2.5rem">
        <span class="eyebrow">Kurse am Hof</span>
        <h2>Lerne, mit Tieren zu sprechen.</h2>
        <p class="lead">Drei Stufen, die aufeinander aufbauen – bei mir am Hof, mit meinen Tieren.</p>
      </div>
      <div class="grid grid--3 scroller" data-scroller>
        {kurse.map((k) => <CourseCard kurs={k} />)}
      </div>
      <div class="scroller__hint" aria-hidden="true">{kurse.map((k, i) => <span class:list={{ 'is-active': i === 0 }}></span>)}</div>
      <p class="center" style="margin-top:2rem"><a href="/kurse#jugendliche">Basis- und Aufbaukurs auch als Jugendkurs</a> · <a href="/kurse#extras">Monatliche Lernabende</a> für alle, die bei mir einen Kurs gemacht haben</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--img-right">
      <div>
        <span class="eyebrow">Über mich</span>
        <h2>Tiere sind mein Lebensmittelpunkt – seit ich denken kann.</h2>
        <p class="lead">Ich lebe mit meinen Tieren auf einem kleinen Hof in Liptingen. Mit 16 bin ich nach Spanien gegangen, um mit Pferden zu leben und von ihnen zu lernen. Später kam die Ausbildung zur Tierkommunikatorin dazu – und damit ein weiterer Traum.</p>
        <p>Heute führe ich Tiergespräche, gebe Kurse und arbeite mit Krafttieren und Energiearbeit. Und jeden Tag begleiten mich meine Hunde Smilla und Mila.</p>
        <a class="btn btn--ghost" href="/ueber-mich">Meine Geschichte</a>
      </div>
      <figure class="photo photo--landscape" style="margin:0">
        <Image src={imgPferd} alt="Steffi kniet lachend neben ihrem liegenden Pferd im Schnee" widths={[480, 800, 1200]} sizes="(min-width: 860px) 560px, 100vw" loading="lazy" />
      </figure>
    </div>
  </section>

  <QuoteBanner
    image={imgAbendrot}
    alt="Abendrot über dem See, davor die Silhouette eines Hundes"
    quote="Die Tiere wissen oft viel besser, was wir brauchen."
    author="Steffi"
    position="center 100%"
    split
  />

  <section class="section section--sand">
    <div class="wrap--narrow">
      <div class="center" style="margin-bottom:2rem">
        <span class="eyebrow">Fragen</span>
        <h2>Was du vielleicht wissen möchtest</h2>
      </div>
      <FAQ items={faq} />
    </div>
  </section>

  <CTA secondary={{ href: '/kurse', label: 'Kurse ansehen' }} />
</Base>

<style>
  .stimme { display: grid; gap: 1.5rem; align-items: center; max-width: 900px; margin: 3rem auto 0; }
  .stimme :global(img) { width: 100%; height: auto; border-radius: var(--radius); box-shadow: var(--shadow); }
  .stimme .testimonial { margin: 0; }
  .stimme__text { font-family: var(--font-body) !important; font-style: normal !important; font-size: 1rem !important; }
  @media (min-width: 760px) { .stimme { grid-template-columns: 320px 1fr; } }
</style>
