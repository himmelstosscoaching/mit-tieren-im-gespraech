---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import QuoteBanner from '../components/QuoteBanner.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import imgGalloway from '../assets/img/steffi-hund-galloway-schnee.jpg';
import imgPferd from '../assets/img/steffi-pferd-schnee.jpg';
import imgHerde from '../assets/img/pferdeherde-gegenlicht.jpg';
---
<Base title="Über mich" description={`${site.owner} – Tierkommunikatorin, Reitlehrerin und Trainerin. Mein Weg zu den Tieren, meine Ausbildung und der kleine Hof in ${site.city}, auf dem ich mit meinen Tieren lebe.`}>
  <section class="section">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Über mich</span>
        <h1>Hallo, ich bin Steffi.</h1>
        <p class="lead">Ich lebe auf einem kleinen Hof in Liptingen, zusammen mit meinen Tieren. Hier habe ich mir mein kleines Paradies erschaffen – und hier darf ich das tun, was ich am meisten liebe: mit Tieren im Gespräch sein.</p>
        <p>Viele unterschiedliche Tiere begleiten mich schon mein ganzes Leben. Sie sind seit langem mein Lebensmittelpunkt – nicht mein Hobby, sondern mein Zuhause.</p>
      </div>
      <figure class="photo photo--portrait" style="margin:0">
        <Image src={imgPferd} alt="Steffi kniet lachend neben ihrem liegenden Pferd im Schnee" widths={[480, 800, 1200]} sizes="(min-width: 860px) 520px, 100vw" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="section section--sand">
    <div class="wrap split split--img-right">
      <div>
        <span class="eyebrow">Mein Weg</span>
        <h2>Mit 16 nach Spanien – zu den Pferden.</h2>
        <p>Mit 16 Jahren bin ich für drei Jahre nach Spanien gegangen, um meinen Traum zu leben: mit Pferden zu leben und von ihnen zu lernen. Danach durfte ich meine Erfahrung als Co-Pferdetrainerin weitergeben und vertiefen. Bis heute bin ich Reitlehrerin und Trainerin.</p>
        <p>2018/2019 habe ich meine Ausbildung in Tierkommunikation bei <strong>Catherin Seib</strong> abgeschlossen – damit ist ein weiterer Traum in Erfüllung gegangen. Seitdem kann ich noch individueller auf jedes Tier-Mensch-Paar eingehen.</p>
        <p>2020 kam die Ausbildung in <strong>schamanischen Heilmethoden bei Lisa Biritz</strong> dazu. Krafttierarbeit, Krafttierreisen und Energiearbeit für Tiere gehören seither ebenso zu meiner Arbeit wie die Tiergespräche.</p>
      </div>
      <figure class="photo photo--landscape" style="margin:0">
        <Image src={imgGalloway} alt="Steffi mit Border Collie und Galloway-Rind im Schnee" widths={[480, 800, 1200]} sizes="(min-width: 860px) 560px, 100vw" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid--3">
      <div class="card">
        <span class="eyebrow">Tierkommunikatorin</span>
        <h3>Tiergespräche</h3>
        <p class="muted">Am Telefon, mit Foto und Namen deines Tieres – für alles, was euch beschäftigt.</p>
        <a class="btn btn--ghost" href="/tiergespraech">Mehr erfahren</a>
      </div>
      <div class="card">
        <span class="eyebrow">Kursleiterin</span>
        <h3>Tierkommunikation lernen</h3>
        <p class="muted">Basis, Aufbau und Profi – hier am Hof, in kleiner Runde, mit meinen Tieren als Lehrern.</p>
        <a class="btn btn--ghost" href="/kurse">Zu den Kursen</a>
      </div>
      <div class="card">
        <span class="eyebrow">Krafttiere &amp; Energiearbeit</span>
        <h3>Schamanische Heilarbeit</h3>
        <p class="muted">Krafttierreisen, Energiearbeit für Tiere und monatliche Lernabende am Hof.</p>
        <a class="btn btn--ghost" href="/kontakt">Nachfragen</a>
      </div>
    </div>
  </section>

  <QuoteBanner image={imgHerde} alt="Pferdeherde im Morgenlicht" quote="Tiere begleiten mich, seit ich denken kann. Sie sind mein Lebensmittelpunkt." author="Steffi" position="center 45%" placeholder />

  <CTA title="Lust, mich und meine Tiere kennenzulernen?" text="Ob Tiergespräch, Kurs oder Lernabend – schreib mir einfach. Ich freue mich auf dich." />
</Base>
