---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import imgPortrait from '../assets/img/steffi-haengestuhl-lachend-mit-pferden.jpg';
import imgSchwimmen from '../assets/img/steffi-schwimmt-mit-hunden.jpg';
import imgEis from '../assets/img/hund-auf-zugefrorenem-see.jpg';
import imgMaehne from '../assets/img/pferdemaehne-goldenes-licht.jpg';
import imgTrommel from '../assets/img/rahmentrommel-auf-wiese.jpg';
import imgSmilla from '../assets/img/smilla-portrait-schnee.jpg';
import imgMila from '../assets/img/steffi-mila-wiese.jpg';
import imgHerde from '../assets/img/pferde-unter-apfelbaum-abendlicht.jpg';
import imgKatze from '../assets/img/kaetzchen-in-jacke.jpg';
import imgFluss from '../assets/img/steffi-magan-kaelbchen-im-fluss.jpg';
// Diese drei laufen auch im Slider der Startseite – bewusst doppelt (Wunsch Annette, 25.11.2026)
import imgGalloway from '../assets/img/steffi-hund-galloway-schnee.jpg';
import imgStuhl from '../assets/img/steffi-haengestuhl-pferde.jpg';
import imgGalopp from '../assets/img/pferd-galopp-apfelbaum.jpg';
---
<Base title="Über mich" description={`${site.owner} – Tierkommunikatorin, Reitlehrerin und Trainerin. Mein Weg zu den Tieren, meine Ausbildung und der kleine Hof in ${site.city}, auf dem ich mit meinen Tieren lebe.`}>
  <section class="section section--zeichnung">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Über mich</span>
        <h1>Hallo, ich bin Steffi.</h1>
        <p class="lead">Ich lebe auf einem kleinen Hof in Liptingen, zusammen mit meinen Tieren. Hier habe ich mir mein kleines Paradies erschaffen – und hier darf ich das tun, was ich am meisten liebe: mit Tieren im Gespräch sein.</p>
        <p>Viele unterschiedliche Tiere begleiten mich schon mein ganzes Leben. Sie sind seit langem mein Lebensmittelpunkt – nicht mein Hobby, sondern mein Zuhause.</p>
      </div>
      <figure class="photo photo--landscape" style="margin:0">
        <Image src={imgPortrait} alt="Steffi sitzt lachend im Hängestuhl unter dem Apfelbaum, zwei Pferde stehen dicht bei ihr, eins schnuppert an ihrer Hand" style="object-position: 45% center" widths={[480, 800, 1200]} sizes="(min-width: 860px) 560px, 100vw" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="section section--sand">
    <div class="wrap split split--img-right">
      <div>
        <span class="eyebrow">Mein Weg</span>
        <h2>Mit 16 nach Spanien – zu den Pferden.</h2>
        <p>Mit 16 Jahren bin ich für drei Jahre nach Spanien gegangen, um mir einen Traum zu erfüllen: mit Pferden zu leben und von ihnen zu lernen. Danach durfte ich meine Erfahrung als Co-Pferdetrainerin weitergeben und vertiefen. Mit 21 habe ich mich selbstständig gemacht und bin bis heute als Reitlehrerin und Trainerin tätig.</p>
        <p>2018/2019 habe ich meine Ausbildung in Tierkommunikation bei <strong>Catherin Seib</strong> abgeschlossen – damit ist ein weiterer Traum in Erfüllung gegangen. Seitdem kann ich noch individueller auf jedes Tier-Mensch-Paar eingehen.</p>
        <p>2020 kam die Ausbildung in <strong>schamanischen Heilmethoden bei Lisa Biritz</strong> auf Hawaii dazu. Krafttierarbeit, Krafttierreisen und Energiearbeit für Tiere gehören seither ebenso zu meiner Arbeit wie die Tiergespräche.</p>
      </div>
      <figure class="photo photo--landscape" style="margin:0">
        <Image src={imgSchwimmen} alt="Steffi schwimmt im See, ihre beiden Hunde schwimmen neben ihr" widths={[480, 800, 1200]} sizes="(min-width: 860px) 560px, 100vw" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="center" style="max-width:720px;margin-inline:auto;margin-bottom:2.5rem">
        <span class="logo-zeichnung" aria-hidden="true"></span>
        <span class="eyebrow">Meine Tiere und ich</span>
        <h2>Hunde, Pferde, Kälbchen, Katzen.</h2>
        <p class="lead">Meine Hunde Smilla und Mila begleiten mich jeden Tag – auf dem Hof und in meinen Kursen. Die Pferde sind seit meiner Jugend meine wichtigsten Lehrer.</p>
      </div>
      <div class="tiere">
        <figure class="tiere__bild">
          <Image src={imgSmilla} alt="Porträt von Smilla, schwarz-weiße Hündin mit braunen Abzeichen, im Schnee" widths={[480, 800, 1024]} sizes="(min-width: 860px) 280px, 50vw" loading="lazy" />
          <figcaption>Smilla</figcaption>
        </figure>
        <figure class="tiere__bild">
          <Image style="object-position: 62% center" src={imgMila} alt="Steffi liegt lachend im Gras und krault Mila, die sich auf dem Rücken räkelt" widths={[480, 800, 1200]} sizes="(min-width: 860px) 280px, 50vw" loading="lazy" />
          <figcaption>Mila und ich</figcaption>
        </figure>
        <figure class="tiere__bild">
          <Image src={imgFluss} alt="Steffi sitzt auf einem Schimmel mitten im Fluss, daneben watet ein schwarzes Kälbchen durchs Wasser" widths={[408]} sizes="(min-width: 860px) 280px, 50vw" loading="lazy" style="object-position: 60% 40%" />
          <figcaption>Zu dritt im Fluss</figcaption>
        </figure>
        <figure class="tiere__bild">
          <Image src={imgKatze} alt="Ein getigertes Kätzchen schaut aus einer türkisen Jacke, eine Hand hält es warm" widths={[400, 637]} sizes="(min-width: 860px) 280px, 50vw" loading="lazy" style="object-position: center 35%" />
          <figcaption>Gut eingepackt</figcaption>
        </figure>
      </div>
      <figure class="tiere__bild tiere__bild--breit">
        <Image src={imgHerde} alt="Meine Pferde grasen am Abend unter dem Apfelbaum auf dem Hof, die Sonne steht tief" widths={[480, 800, 1200, 1800]} sizes="(min-width: 1180px) 1180px, 100vw" loading="lazy" />
        <figcaption>Abends auf dem Hof</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--sand">
    <div class="wrap">
      <div class="center" style="max-width:720px;margin-inline:auto;margin-bottom:2.5rem">
        <span class="eyebrow">Hofleben</span>
        <h2>Durchs Jahr mit meinen Tieren.</h2>
        <p class="lead">Ob abends im Hängesessel, im tiefen Schnee oder auf der Streuobstwiese: Die schönsten Momente entstehen ganz nebenbei, mitten im Alltag mit den Tieren.</p>
      </div>
      <div class="hof">
        <figure class="hof__bild hof__bild--breit">
          <Image src={imgStuhl} alt="Steffi sitzt im Hängesessel auf der Wiese, ein Pferd kommt zu ihr, ihr Hund steht daneben – Abendlicht" widths={[600, 1000, 1600, 2400]} sizes="(min-width: 1180px) 1180px, 100vw" loading="lazy" style="object-position: 35% center" />
          <figcaption>Auszeit im Hängesessel</figcaption>
        </figure>
        <figure class="hof__bild">
          <Image src={imgGalloway} alt="Steffi kniet im Schnee, im Arm ihre Hündin Smilla, daneben das schwarze Galloway-Rind Frida" widths={[480, 800, 1200]} sizes="(min-width: 860px) 640px, 50vw" loading="lazy" style="object-position: 40% center" />
          <figcaption>Winter mit Smilla und Frida</figcaption>
        </figure>
        <figure class="hof__bild">
          <Image src={imgGalopp} alt="Ein Pferd galoppiert unter den Apfelbäumen, der Himmel leuchtet rosa" widths={[400, 700, 1000]} sizes="(min-width: 860px) 420px, 50vw" loading="lazy" style="object-position: 70% 55%" />
          <figcaption>Freiheit auf der Streuobstwiese</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid--3">
      <div class="card card--img card--farbe" style="--farbe: var(--turq)">
        <Image src={imgEis} alt="Ein Border Collie läuft über den zugefrorenen See, seine Spuren im Schnee" widths={[480, 800]} sizes="(min-width: 860px) 280px, 50vw" loading="lazy" />
        <div class="card__body">
          <h3>Tiergespräche</h3>
          <p class="muted">Am Telefon, mit Foto und Namen deines Tieres – für alles, was euch beschäftigt.</p>
          <a class="btn btn--ghost" href="/tiergespraech">Mehr erfahren</a>
        </div>
      </div>
      <div class="card card--img card--farbe" style="--farbe: var(--blue)">
        <Image src={imgMaehne} alt="Die Mähne eines Schimmels leuchtet im goldenen Abendlicht" widths={[480, 800]} sizes="(min-width: 860px) 280px, 50vw" loading="lazy" />
        <div class="card__body">
          <h3>Tierkommunikation lernen</h3>
          <p class="muted">Basis, Aufbau und Profi – hier am Hof, in kleiner Runde, mit meinen Tieren als Lehrern.</p>
          <a class="btn btn--ghost" href="/kurse">Zur Ausbildung</a>
        </div>
      </div>
      <div class="card card--img card--farbe" style="--farbe: var(--violet)">
        <Image src={imgTrommel} alt="Eine Rahmentrommel liegt auf der Sommerwiese" widths={[480, 800]} sizes="(min-width: 860px) 280px, 50vw" loading="lazy" />
        <div class="card__body">
          <h3>Schamanische Heilarbeit</h3>
          <p class="muted">Krafttierreisen und Energiearbeit für Tiere.</p>
          <a class="btn btn--ghost" href="/krafttiere">Mehr erfahren</a>
        </div>
      </div>
    </div>
  </section>

  <CTA title="Lust, mich und meine Tiere kennenzulernen?" text="Ob Tiergespräch, Kurs oder Lernabend – schreib mir einfach. Ich freue mich auf dich." />
</Base>

<style>
  .tiere { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(0.9rem, 3vw, 2rem); }
  @media (min-width: 900px) { .tiere { grid-template-columns: repeat(4, 1fr); } }
  .tiere__bild { margin: 0; }
  .tiere__bild img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; object-position: center 30%; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .tiere__bild--breit { margin-top: clamp(1.25rem, 3vw, 2rem); }
  .tiere__bild--breit img { aspect-ratio: 16 / 9; object-position: center 60%; }
  @media (max-width: 759px) { .tiere__bild--breit img { aspect-ratio: 4 / 3; } }
  .tiere__bild figcaption { margin-top: 0.75rem; text-align: center; font-family: var(--font-logo); font-style: italic; font-size: clamp(1.05rem, 2.6vw, 1.35rem); color: var(--ink-soft); }
  /* Hofleben: oben das breite Hängesessel-Bild, darunter zwei Bilder nebeneinander (am PC gleich hoch) */
  .hof { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(0.9rem, 3vw, 2rem); }
  .hof__bild { margin: 0; }
  .hof__bild--breit { grid-column: 1 / -1; }
  .hof__bild img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .hof__bild--breit img { aspect-ratio: 2 / 1; }
  @media (min-width: 860px) {
    .hof { grid-template-columns: 1.5fr 1fr; }
    .hof__bild--breit img { aspect-ratio: 21 / 9; }
    .hof__bild:not(.hof__bild--breit) img { aspect-ratio: auto; height: clamp(340px, 34vw, 440px); }
  }
  .hof__bild figcaption { margin-top: 0.75rem; text-align: center; font-family: var(--font-logo); font-style: italic; font-size: clamp(1.05rem, 2.6vw, 1.35rem); color: var(--ink-soft); }
</style>
